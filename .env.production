# Compilación para el servidor de la empresa (IIS): el frontend en la raíz del sitio y la API como
# aplicación de IIS en /service. La URL es relativa: misma dirección, sin CORS.
# Para otro despliegue, sobrescribe con una variable de entorno al compilar.
VITE_API_URL=/service/api

# KRUD en producción: vacío hasta que el operador de KRUD registre el servidor de la empresa.
VITE_KRUD_ORIGEN=
